# Copy to .env.local. Every VITE_ value ends up in the public bundle, so never put a secret here.

# Base URL of dome-backend. Leave empty in development to use the Vite proxy below.
VITE_DOME_API_URL=
# Where `pnpm dev` proxies /v1 requests when VITE_DOME_API_URL is empty.
DOME_API_PROXY_TARGET=http://localhost:8080

# testnet (default) or mainnet. Curator actions stay on testnet until the registry is reviewed.
VITE_STELLAR_NETWORK=testnet
# Dome Registry contract id; the dome-contracts README lists the current one per network.
VITE_REGISTRY_CONTRACT_ID=CCHLCPUBLL4ROEFP5PR3JY4LUB32TLNB2KDF3DQLG3R53IK5OUW7TZUY
